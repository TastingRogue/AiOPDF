<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/AiOPDF/AiOPDF.csproj" /><PackageReference Include="Avalonia.Headless" Version="12.1.4" /></ItemGroup>
  <Target Name="CopyAppOcrModels" AfterTargets="Build">
    <ItemGroup><AppOcrModel Include="$(MSBuildThisFileDirectory)../../src/AiOPDF/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/models/v5/*" /></ItemGroup>
    <Error Condition="'@(AppOcrModel)' == ''" Text="OCR models were not produced by the application build." />
    <Copy SourceFiles="@(AppOcrModel)" DestinationFolder="$(TargetDir)models/v5/" />
  </Target>
</Project>
