<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Explicitly lock the bundler used by macOS single-file publishing. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Use the same native Skia family as PDFtoImage; avoid two competing Linux libSkiaSharp files. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup><AvaloniaResource Include="Assets/**" /></ItemGroup>
  <ItemGroup><AvaloniaResource Include="StudioTheme.axaml" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/Lato-Regular.ttf" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Localization/*.json" /></ItemGroup>
</Project>






